# ═══════════════════════════════════════════════════════════════════════════
#  متغیرهای محیطی فرانت‌اند «هم‌سهم»
#  نکتهٔ مهم: API_BASE_URL فقط origin است (بدون /api/v1)؛ مسیر عملیات از قرارداد
#  OpenAPI خوانده می‌شود و خودش /api/v1/... را اضافه می‌کند.
# ═══════════════════════════════════════════════════════════════════════════

# سمت سرور (SSR/RSC) — در تولید می‌تواند http://127.0.0.1:… هم باشد اگر پشت پروکسی باشد
API_BASE_URL=https://api.alavi-fars.ir

# همان origin برای کد مرورگر؛ فرانت و API same-site هستند و کوکی با credentials می‌رود
NEXT_PUBLIC_API_BASE_URL=https://api.alavi-fars.ir

# آدرس عمومی سایت (canonical، sitemap، OG)
NEXT_PUBLIC_SITE_URL=https://alavi-fars.ir
