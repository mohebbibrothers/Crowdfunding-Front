{
  "name": "crowdfunding-front",
  "version": "0.1.0",
  "private": true,
  "description": "فرانت‌اند سکوی کرادفاندینگ خیرخواهانه — سهم‌محور، شفاف و راست‌به‌چپ",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
